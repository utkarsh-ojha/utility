  echo -e "${CYAN}${BOLD}  ╚╝╩ ╩ ╚╝ ╩ ╩  ${GREEN} ╚╝ ╚═╝╩╚═╚═╝╩╚═╝╝╚╝  ${YELLOW}╩ ╩╩╩ ╩╝╚╝╩ ╩╚═╝╚═╝╩╚═${RESET}"
