#!/usr/bin/env bash

###############################################
# First-time setup guide for any Mac:

# ---

# **Step 1 — Download the script**

# Download the `jvm` file and save it to your Downloads folder.

# ---

# **Step 2 — Install it**

# Open Terminal and run:

# ```bash
# chmod +x ~/Downloads/jvm
# sudo mv ~/Downloads/jvm /usr/local/bin/jvm
# ```

# > If you're on Apple Silicon (M1/M2/M3) and get a "No such file or directory" error, use this instead:
# > ```bash
# > sudo mv ~/Downloads/jvm /opt/homebrew/bin/jvm
# > ```

# ---

# **Step 3 — Verify it works**

# ```bash
# jvm help
# ```

# You should see the full command list printed.

# ---

# **Step 4 — Install Homebrew (if you don't have it)**

# ```bash
# /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
# ```

# Skip this if `brew --version` already works.

# ---

# **Step 5 — Install your first Java version**

# ```bash
# jvm install 21
# ```

# Pick `temurin@21` from the menu — it's the most compatible option for all Macs including Apple Silicon.

# ---

# **Step 6 — Switch to it**

# ```bash
# jvm use 21
# ```

# ---

# **Step 7 — Apply to current terminal**

# ```bash
# source ~/.zshrc
# ```

# ---

# **Step 8 — Verify Java is working**

# ```bash
# java -version
# echo $JAVA_HOME
# jvm doctor
# ```

# All green? You're done.

# ---

# **From this point on**, every new terminal will have Java automatically. To switch versions in the future just run `jvm use <version>`. That's it.
################################################


# Note: -u (nounset) intentionally omitted — empty array expansion crashes under -u in bash/zsh
set -eo pipefail

# ─── Colours ─────────────────────────────────────────────────────────────────
BOLD="\033[1m";  DIM="\033[2m";     RESET="\033[0m"
RED="\033[0;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"
CYAN="\033[0;36m"; BLUE="\033[0;34m"; MAGENTA="\033[0;35m"
WHITE="\033[1;37m"

# ─── Config paths ─────────────────────────────────────────────────────────────
# All jvm state lives under ~/.jvm/: pinned versions, named aliases, switch history
JVM_DATA_DIR="${HOME}/.jvm"
JVM_PINS_FILE="${JVM_DATA_DIR}/pins"        # One version per line — protected from remove/clean
JVM_ALIASES_FILE="${JVM_DATA_DIR}/aliases"  # name=version pairs for friendly shortcuts
JVM_HISTORY_FILE="${JVM_DATA_DIR}/history"  # Timestamped log of every switch/install

# Ensure data dir and files exist on first run
mkdir -p "$JVM_DATA_DIR"
touch "$JVM_PINS_FILE" "$JVM_ALIASES_FILE" "$JVM_HISTORY_FILE"

# ─── Platform detection ───────────────────────────────────────────────────────
detect_platform() {
  OS="unknown"; ARCH="unknown"; PKG_MANAGER="unknown"
  case "$(uname -s)" in
    Darwin)
      OS="macos"
      case "$(uname -m)" in
        arm64)  ARCH="arm64" ;;
        x86_64) ARCH="x86_64" ;;
      esac
      PKG_MANAGER="brew"
      ;;
    Linux)
      OS="linux"
      case "$(uname -m)" in
        aarch64|arm64) ARCH="arm64" ;;
        x86_64)        ARCH="x86_64" ;;
        armv7l)        ARCH="armv7" ;;
      esac
      if command -v apt-get  &>/dev/null; then PKG_MANAGER="apt"
      elif command -v dnf    &>/dev/null; then PKG_MANAGER="dnf"
      elif command -v yum    &>/dev/null; then PKG_MANAGER="yum"
      elif command -v pacman &>/dev/null; then PKG_MANAGER="pacman"
      elif command -v zypper &>/dev/null; then PKG_MANAGER="zypper"
      elif command -v brew   &>/dev/null; then PKG_MANAGER="brew"
      fi
      ;;
    *)
      echo -e "${RED}Unsupported OS: $(uname -s)${RESET}"; exit 1 ;;
  esac
}

# Returns the path to the user's shell profile file (e.g. ~/.zshrc, ~/.bashrc)
# Used to persist JAVA_HOME exports across terminal sessions
get_shell_profile() {
  local sh; sh=$(basename "${SHELL:-bash}")
  case "$sh" in
    zsh)  echo "${ZDOTDIR:-$HOME}/.zshrc" ;;
    bash)
      if [[ "$OS" == "macos" ]]; then echo "$HOME/.bash_profile"
      else echo "$HOME/.bashrc"; fi ;;
    fish) echo "$HOME/.config/fish/config.fish" ;;
    *)    echo "$HOME/.profile" ;;
  esac
}

# ─── Pretty-print helpers ─────────────────────────────────────────────────────
# Consistent, colour-coded output used by every command
div()     { echo -e "${DIM}  ────────────────────────────────────────────────────${RESET}"; }
section() { echo ""; echo -e "  ${CYAN}${BOLD}$1${RESET}"; div; }
ok()      { echo -e "  ${GREEN}✓${RESET} $*"; }      # Success message
warn()    { echo -e "  ${YELLOW}⚠${RESET}  $*"; }    # Non-fatal warning
err()     { echo -e "  ${RED}✗${RESET} $*"; }        # Error message
info()    { echo -e "  ${BLUE}→${RESET} $*"; }       # Informational hint
step()    { echo -e "  ${MAGENTA}◆${RESET} $*"; }    # Action step being performed

banner() {
  echo ""
  echo -e "${CYAN}${BOLD}  ☕ Java Version Manager - By: Utkarsh${RESET}"
  echo -e "${DIM}  Platform: ${OS} / ${ARCH} / pkg:${PKG_MANAGER}${RESET}"
  div; echo ""
}

# Ensures Homebrew is available; installs it if missing on macOS.
# On Linux with a native pkg manager (apt/dnf/etc.) returns failure — Homebrew is optional there.
ensure_brew() {
  command -v brew &>/dev/null && return 0
  if [[ "$OS" == "linux" && "$PKG_MANAGER" != "brew" ]]; then return 1; fi
  warn "Homebrew not found. Installing it now..."
  echo ""
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [[ "$OS" == "macos" && "$ARCH" == "arm64" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    local profile; profile=$(get_shell_profile)
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> "$profile"
  elif [[ "$OS" == "macos" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  else
    eval "$(${HOME}/.linuxbrew/bin/brew shellenv 2>/dev/null || /home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
  ok "Homebrew installed."
}

# Writes the JAVA_HOME export block into the user's shell profile.
# 1. Strips any previous jvm-manager block to avoid duplicates
# 2. Appends the new JAVA_HOME + PATH export (fish or POSIX syntax)
# 3. Exports into the current process so subsequent commands see the change
write_java_home() {
  local path="$1"
  local profile; profile=$(get_shell_profile)
  local sh; sh=$(basename "${SHELL:-bash}")

  # Remove any existing jvm-manager block from the profile
  if [[ -f "$profile" ]]; then
    grep -v "# >>> jvm-manager" "$profile" | \
    grep -v "export JAVA_HOME=" | \
    grep -v 'export PATH="$JAVA_HOME' | \
    grep -v "set -x JAVA_HOME" | \
    grep -v "set -x PATH" | \
    grep -v "# <<< jvm-manager" > "${profile}.jvmtmp" && mv "${profile}.jvmtmp" "$profile"
  fi

  if [[ "$sh" == "fish" ]]; then
    { echo ""; echo "# >>> jvm-manager (managed — do not edit manually)"
      echo "set -x JAVA_HOME \"${path}\""
      echo "set -x PATH \$JAVA_HOME/bin \$PATH"
      echo "# <<< jvm-manager"; } >> "$profile"
  else
    { echo ""; echo "# >>> jvm-manager (managed — do not edit manually)"
      echo "export JAVA_HOME=\"${path}\""
      echo 'export PATH="$JAVA_HOME/bin:$PATH"'
      echo "# <<< jvm-manager"; } >> "$profile"
  fi

  export JAVA_HOME="$path"
  export PATH="$JAVA_HOME/bin:$PATH"

  ok "JAVA_HOME → ${CYAN}${path}${RESET}"
  ok "Profile updated → ${CYAN}${profile}${RESET}"
  echo ""
  echo -e "  ${YELLOW}${BOLD}  ↻  To apply in this terminal, run:${RESET}"
  echo -e "  ${BOLD}     source ${profile}${RESET}"
  echo ""
}

# Appends a timestamped entry to the switch history log
log_switch() {
  echo "$(date '+%Y-%m-%d %H:%M:%S')  Java ${1}  ${2}" >> "$JVM_HISTORY_FILE"
}

# ─── JVM discovery arrays ─────────────────────────────────────────────────────
# Parallel arrays populated by scan_jvms → _register_jvm:
#   ALL_JVM_PATHS    — absolute path to each JAVA_HOME
#   ALL_JVM_VERSIONS — major version number (e.g. "21")
#   ALL_JVM_VENDORS  — vendor name (e.g. "Temurin", "Zulu")
declare -a ALL_JVM_PATHS=()
declare -a ALL_JVM_VERSIONS=()
declare -a ALL_JVM_VENDORS=()

# Registers a single JVM installation into the discovery arrays.
# Deduplicates by resolving symlinks, extracts version + vendor from `java -version`.
_register_jvm() {
  local home="$1"
  # Skip if java binary is missing or not executable
  [[ -x "${home}/bin/java" ]] || return 0

  # Resolve symlinks so /usr/lib/jvm/default-java and java-21-openjdk-amd64 don't duplicate
  local real_home
  real_home=$(realpath "$home" 2>/dev/null || readlink -f "$home" 2>/dev/null || echo "$home")

  local _n=${#ALL_JVM_PATHS[@]}
  local _i=0
  while [[ $_i -lt $_n ]]; do
    local _real_existing
    _real_existing=$(realpath "${ALL_JVM_PATHS[$_i]}" 2>/dev/null || echo "${ALL_JVM_PATHS[$_i]}")
    [[ "$_real_existing" == "$real_home" ]] && return 0
    _i=$((_i+1))
  done

  # Run `java -version` with a timeout to extract version string
  # gtimeout (GNU coreutils on macOS via brew) is preferred, then `timeout`, then raw
  local vline
  if command -v gtimeout &>/dev/null; then
    vline=$(gtimeout 3s "${home}/bin/java" -version 2>&1 | head -1) || return 0
  elif command -v timeout &>/dev/null; then
    vline=$(timeout 3s "${home}/bin/java" -version 2>&1 | head -1) || return 0
  else
    vline=$("${home}/bin/java" -version 2>&1 | head -1) || return 0
  fi

  # Parse version string: extract semver from quotes, normalise legacy "1.x" → "x"
  local ver
  ver=$(echo "$vline" | grep -oE '"[0-9]+\.[0-9]+(\.[0-9]+)*' | tr -d '"' | head -1)
  [[ -z "$ver" ]] && ver=$(echo "$vline" | grep -oE '"[0-9]+' | tr -d '"' | head -1)
  [[ "$ver" == 1.* ]] && ver="${ver#1.}"
  local major
  major=$(echo "$ver" | cut -d'.' -f1)
  [[ -z "$major" ]] && major="$ver"

  # Detect vendor from the version output string, falling back to path-based heuristics
  local vendor
  vendor=$(echo "$vline" | grep -oiE 'Temurin|Zulu|Corretto|GraalVM|Liberica|Semeru|Microsoft' | head -1 || true)
  if [[ -z "$vendor" ]]; then
    case "$home" in
      *ms-*|*microsoft*)        vendor="Microsoft" ;;
      *temurin*)                vendor="Temurin" ;;
      *zulu*)                   vendor="Zulu" ;;
      *corretto*)               vendor="Corretto" ;;
      *graalvm*)                vendor="GraalVM" ;;
      *liberica*)               vendor="Liberica" ;;
      *semeru*)                 vendor="Semeru" ;;
      *jbr*|*jetbrains*|*JBR*) vendor="JetBrains" ;;
      *oracle*)                 vendor="Oracle" ;;
      *)                        vendor="OpenJDK" ;;
    esac
  fi

  # Store the discovered JVM in the parallel arrays
  ALL_JVM_PATHS+=("$home")
  ALL_JVM_VERSIONS+=("$major")
  ALL_JVM_VENDORS+=("$vendor")
}

# Scans the entire machine for installed JVMs.
# Searches: macOS java_home utility, standard JVM directories, Homebrew opt, and SDKMAN.
# Populates ALL_JVM_PATHS / ALL_JVM_VERSIONS / ALL_JVM_VENDORS via _register_jvm().
scan_jvms() {
  ALL_JVM_PATHS=(); ALL_JVM_VERSIONS=(); ALL_JVM_VENDORS=()

  # ── 1. macOS /usr/libexec/java_home -V (fastest, authoritative) ─────────────
  if [[ "$OS" == "macos" ]] && [[ -x /usr/libexec/java_home ]]; then
    local _jh_tmp; _jh_tmp=$(mktemp)
    /usr/libexec/java_home -V 2>&1 | grep -E "^[[:space:]]+[0-9]" > "$_jh_tmp" || true
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local _p; _p=$(echo "$line" | awk '{print $NF}')
      [[ -d "$_p" ]] && _register_jvm "$_p"
    done < "$_jh_tmp"
    rm -f "$_jh_tmp"
  fi

  # ── 2. Standard JVM locations ───────────────────────────────────────────────
  local _dirs=()
  if [[ "$OS" == "macos" ]]; then
    _dirs+=("/Library/Java/JavaVirtualMachines" "${HOME}/Library/Java/JavaVirtualMachines")
  fi
  _dirs+=("/usr/lib/jvm" "/usr/java" "/usr/local/lib/jvm" "/opt/java" "/opt/jdk")

  # ── 3. Homebrew opt — ONLY java-related dirs (avoids scanning all of opt) ───
  if command -v brew &>/dev/null; then
    # Cache brew prefix — avoids calling brew twice and hitting update locks
    local _bp; _bp=$(brew --prefix 2>/dev/null)
    if [[ -n "$_bp" && -d "${_bp}/opt" ]]; then
      # Only look at dirs whose name contains java/jdk/temurin/zulu/corretto etc.
      local _bopt="${_bp}/opt"
      for _jdir in "${_bopt}"/java* "${_bopt}"/openjdk* "${_bopt}"/temurin*                    "${_bopt}"/zulu* "${_bopt}"/corretto* "${_bopt}"/liberica*                    "${_bopt}"/semeru* "${_bopt}"/graalvm* "${_bopt}"/microsoft-openjdk*; do
        [[ -d "$_jdir" ]] && _dirs+=("$_jdir")
      done
    fi
  fi

  [[ -d "${HOME}/.sdkman/candidates/java" ]] && _dirs+=("${HOME}/.sdkman/candidates/java")

  # ── 4. Scan each dir ─────────────────────────────────────────────────────────
  local _base _cand _sub _bn
  local _di=0
  local _dlen=${#_dirs[@]}
  while [[ $_di -lt $_dlen ]]; do
    _base="${_dirs[$_di]}"
    _di=$((_di+1))
    [[ -d "$_base" ]] || continue

    for _cand in "${_base}"/*/; do
      [[ "$_cand" == *'*/' ]] && continue
      [[ -d "$_cand" ]] || continue
      _bn=$(basename "${_cand%/}")
      [[ "$_bn" == .* ]] && continue
      # For brew opt sub-dirs (already java-filtered above), register directly
      [[ -d "${_cand}Contents/Home" ]] && _register_jvm "${_cand}Contents/Home"
      _register_jvm "${_cand%/}"
      for _sub in "libexec/openjdk.jdk/Contents/Home" "libexec"; do
        [[ -d "${_cand}${_sub}" ]] && _register_jvm "${_cand}${_sub}"
      done
    done
  done
}

# ─── Homebrew Java package search ─────────────────────────────────────────────
declare -a BREW_FORMULAE=()
declare -a BREW_CASKS=()

# Looks up known Homebrew formula/cask names for a given Java version.
# Uses `brew info` probes (O(1)) rather than slow regex searches.
# Populates BREW_FORMULAE[] and BREW_CASKS[] arrays.
brew_search_java() {
  local version="${1:-}"
  BREW_FORMULAE=(); BREW_CASKS=()
  command -v brew &>/dev/null || return

  # Use `brew info` on known formula/cask names — fast O(1) vs slow regex search
  # Known Homebrew formula names for each Java version
  local _formulae=()
  local _casks=()

  if [[ -n "$version" ]]; then
    _formulae=("openjdk@${version}" "temurin@${version}" "zulu@${version}"
               "corretto@${version}" "semeru@${version}" "liberica@${version}")
    _casks=("temurin@${version}" "zulu@${version}" "corretto@${version}"
            "liberica@${version}" "microsoft-openjdk@${version}")
    # Latest (unversioned) openjdk — only include if version matches latest (21)
    [[ "$version" == "21" ]] && _formulae+=("openjdk")
  else
    _formulae=("openjdk" "openjdk@17" "openjdk@21" "openjdk@11"
               "temurin" "zulu" "corretto" "semeru")
    _casks=("temurin" "zulu" "corretto" "liberica" "microsoft-openjdk"
            "temurin@17" "temurin@21" "zulu@17" "zulu@21")
  fi

  # Check formulae — brew info exits 0 if formula exists in tap
  local _f
  for _f in "${_formulae[@]}"; do
    brew info --formula "$_f" &>/dev/null 2>&1 && BREW_FORMULAE+=("$_f")
  done

  # Check casks
  local _c
  for _c in "${_casks[@]}"; do
    brew info --cask "$_c" &>/dev/null 2>&1 || continue
    # Skip if already in formulae list
    local _dup=false
    local _ff; for _ff in "${BREW_FORMULAE[@]:-}"; do [[ "$_ff" == "$_c" ]] && _dup=true && break; done
    [[ "$_dup" == "false" ]] && BREW_CASKS+=("$_c")
  done
}

# ─── Linux package-manager search ────────────────────────────────────────────
declare -a LINUX_PKGS=()

# Searches apt/dnf/yum/pacman/zypper for JDK packages matching a version.
# Populates LINUX_PKGS[] array with available package names.
linux_search_java() {
  local version="${1:-}"
  LINUX_PKGS=()
  local results=""

  case "$PKG_MANAGER" in
    apt)
      results=$(apt-cache search "openjdk\|temurin\|zulu\|corretto" 2>/dev/null | grep -i "jdk\|java" | \
        { [[ -n "$version" ]] && grep -E "\-${version}[^0-9]|\-${version}$" || cat; } | awk '{print $1}' | sort -u || true) ;;
    dnf|yum)
      results=$(${PKG_MANAGER} list available 2>/dev/null | grep -iE "java|jdk" | \
        { [[ -n "$version" ]] && grep -E "\-${version}[^0-9]|\-${version}$|${version}u" || cat; } | awk '{print $1}' | sort -u || true) ;;
    pacman)
      results=$(pacman -Ss "jdk" 2>/dev/null | grep "^extra\|^community\|^archlinux" | \
        { [[ -n "$version" ]] && grep -E "${version}" || cat; } | awk -F'/' '{print $2}' | awk '{print $1}' | sort -u || true) ;;
    zypper)
      results=$(zypper search "java" 2>/dev/null | grep -iE "jdk|java-${version}" | awk '{print $3}' | sort -u || true) ;;
  esac

  while IFS= read -r p; do [[ -n "$p" ]] && LINUX_PKGS+=("$p"); done <<< "$results"
}

# Resolves a Homebrew formula/cask to its JAVA_HOME path.
# Strategy: cask → scan /Library/Java/JavaVirtualMachines; formula → brew --prefix + known sub-paths.
# Falls back to macOS java_home utility, then full scan_jvms() as last resort.
resolve_brew_java_home() {
  local pkg="$1"; local is_cask="${2:-false}"; local version="${3:-}"
  local result=""

  if [[ "$is_cask" == "true" ]]; then
    for _base in "/Library/Java/JavaVirtualMachines" "${HOME}/Library/Java/JavaVirtualMachines"; do
      [[ -d "$_base" ]] || continue
      local _found
      _found=$(ls -d "${_base}"/*/Contents/Home 2>/dev/null | \
        { [[ -n "$version" ]] && grep -E "(^|/)${version}[^0-9/]|${version}\." || cat; } | \
        sort -rV | head -1 || true)
      [[ -n "$_found" ]] && { result="$_found"; break; }
    done
  else
    local prefix; prefix=$(brew --prefix "$pkg" 2>/dev/null || true)
    if [[ -n "$prefix" ]]; then
      for _sub in "libexec/openjdk.jdk/Contents/Home" "libexec/Contents/Home" "libexec" ""; do
        local _c="${prefix}/${_sub}"; _c="${_c%/}"
        if [[ -d "$_c" && -x "${_c}/bin/java" ]]; then result="$_c"; break; fi
      done
      if [[ -n "$result" && "$OS" == "macos" ]]; then
        local _jdk_bundle="${prefix}/libexec/openjdk.jdk"
        local _symlink_target="/Library/Java/JavaVirtualMachines/$(basename "${prefix}").jdk"
        if [[ -d "$_jdk_bundle" && ! -e "$_symlink_target" ]]; then
          sudo ln -sfn "$_jdk_bundle" "$_symlink_target" 2>/dev/null && ok "Created system symlink: ${_symlink_target}" || true
        fi
      fi
    fi
  fi

  if [[ -z "$result" && "$OS" == "macos" && -n "$version" ]]; then
    result=$(/usr/libexec/java_home -v "${version}" 2>/dev/null || true)
  fi

  if [[ -z "$result" ]]; then
    scan_jvms
    local _i
    for _i in "${!ALL_JVM_VERSIONS[@]}"; do
      local _maj; _maj=$(echo "${ALL_JVM_VERSIONS[$_i]}" | cut -d. -f1)
      if [[ "$_maj" == "$version" ]]; then result="${ALL_JVM_PATHS[$_i]}"; break; fi
    done
  fi

  echo "$result"
}

# ─── Pin management (protect versions from removal) ─────────────────────────
is_pinned()    { grep -qxF "$1" "$JVM_PINS_FILE" 2>/dev/null; }
add_pin()      { is_pinned "$1" && { warn "Java ${1} already pinned."; return; }
                 echo "$1" >> "$JVM_PINS_FILE"; ok "Pinned Java ${1}."; }
remove_pin()   { grep -vxF "$1" "$JVM_PINS_FILE" > "${JVM_PINS_FILE}.tmp" 2>/dev/null || true
                 mv "${JVM_PINS_FILE}.tmp" "$JVM_PINS_FILE"
                 ok "Unpinned Java ${1}."; }
list_pins()    { [[ ! -s "$JVM_PINS_FILE" ]] && { info "No pinned versions."; return; }
                 while IFS= read -r p; do echo -e "  ${YELLOW}📌${RESET} Java ${p}"; done < "$JVM_PINS_FILE"; }

# ─── Alias management (named shortcuts for versions) ────────────────────────
set_alias()      { grep -v "^${1}=" "$JVM_ALIASES_FILE" > "${JVM_ALIASES_FILE}.tmp" 2>/dev/null || true
                   mv "${JVM_ALIASES_FILE}.tmp" "$JVM_ALIASES_FILE"
                   echo "${1}=${2}" >> "$JVM_ALIASES_FILE"; ok "Alias '${1}' → Java ${2}"; }
resolve_alias()  { grep "^${1}=" "$JVM_ALIASES_FILE" 2>/dev/null | cut -d'=' -f2 | head -1 || echo ""; }
list_aliases()   { [[ ! -s "$JVM_ALIASES_FILE" ]] && { info "No aliases set."; return; }
                   while IFS='=' read -r n v; do [[ -n "$n" ]] && echo -e "  ${MAGENTA}→${RESET} ${BOLD}${n}${RESET}  ≡  Java ${v}"; done < "$JVM_ALIASES_FILE"; }

