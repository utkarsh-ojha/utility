# Per-command detailed help renderer (called from cmd_help when a topic is given)
_help_topic() {
  local t="$1"
  case "$t" in
    use)     section "jvm use <version|alias>"
             echo -e "  Interactively switch Java versions."
             echo -e "  Shows locally installed JVMs first, then package manager options."
             echo -e "  Writes JAVA_HOME + PATH to your shell profile automatically."
             echo -e "\n  ${DIM}jvm use 17      # pick from Java 17 variants${RESET}"
             echo -e "  ${DIM}jvm use work    # switch via alias 'work'${RESET}" ;;
    doctor)  section "jvm doctor"
             echo -e "  Full health check: JAVA_HOME, PATH, symlinks, profile conflicts, SDKMAN." ;;
    env)     section "jvm env [version]"
             echo -e "  Prints shell export commands to stdout — ideal for CI/CD."
             echo -e "\n  ${DIM}jvm env 17           # prints: export JAVA_HOME=...${RESET}"
             echo -e "  ${DIM}eval \$(jvm env 17)   # apply inline in any script${RESET}" ;;
    project) section "jvm project [version]"
             echo -e "  Writes/reads a .java-version file in the current directory." ;;
    alias)   section "jvm alias <name> <version>"
             echo -e "  Creates a named shortcut.\n  ${DIM}jvm alias work 17${RESET}" ;;
    install) section "jvm install <version>"
             echo -e "  Installs without switching.\n  ${DIM}jvm install 21${RESET}" ;;
    clean)   section "jvm clean"
             echo -e "  Removes all except active. Respects pins." ;;
    pin)     section "jvm pin / unpin / pins"
             echo -e "  Protect versions from remove/clean." ;;
    *)       info "No detailed help for '${t}'. Try ${BOLD}jvm help${RESET}." ;;
  esac
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm list
# Scans the machine for all installed JVMs and displays them in a numbered list.
# Highlights the currently active one (matching $JAVA_HOME) and shows pinned status.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_list() {
  banner; section "Installed Java Versions"; scan_jvms

  if [[ ${#ALL_JVM_PATHS[@]} -eq 0 ]]; then
    warn "No Java versions found on this machine."
    info "Try: ${BOLD}jvm install 21${RESET}"; echo ""; return
  fi

  local active_home="${JAVA_HOME:-}"
  echo -e "  ${DIM}Found ${#ALL_JVM_PATHS[@]} Java installation(s)${RESET}"; echo ""

  local i=0
  while [[ $i -lt ${#ALL_JVM_PATHS[@]} ]]; do
    local jpath="${ALL_JVM_PATHS[$i]}"
    local jver="${ALL_JVM_VERSIONS[$i]}"
    local jvendor="${ALL_JVM_VENDORS[$i]}"
    local num=$((i+1))
    if [[ "$jpath" == "$active_home" ]]; then
      echo -e "  ${GREEN}${BOLD}▶ [${num}] Java ${jver} — ${jvendor}${RESET}  ${GREEN}← active${RESET}"
    else
      echo -e "  ${CYAN}  [${num}] Java ${jver} — ${jvendor}${RESET}"
    fi
    echo -e "       ${DIM}${jpath}${RESET}"
    is_pinned "$jver" && echo -e "       ${YELLOW}📌 pinned${RESET}"
    echo ""
    i=$((i+1))
  done

  if command -v java &>/dev/null; then
    ok "Active: ${CYAN}$(java -version 2>&1 | head -1)${RESET}"
  fi
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm current
# Displays the currently active Java: version string, JAVA_HOME, binary path,
# and which shell profile file contains the JAVA_HOME export.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_current() {
  banner; section "Active Java"
  if ! command -v java &>/dev/null; then
    err "java not found in PATH."; info "Try: ${BOLD}jvm use <version>${RESET}"; echo ""; return 1
  fi
  local profile; profile=$(get_shell_profile)
  local in_profile="not found"
  [[ -f "$profile" ]] && grep -q "JAVA_HOME" "$profile" && in_profile="$profile"
  ok "Version:   ${CYAN}$(java -version 2>&1 | head -1)${RESET}"
  ok "JAVA_HOME: ${CYAN}${JAVA_HOME:-not set}${RESET}"
  ok "java bin:  ${CYAN}$(command -v java)${RESET}"
  ok "Profile:   ${CYAN}${in_profile}${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm search [version]
# Queries Homebrew (formulae + casks) and native Linux pkg managers for available
# JDK packages. Shows installed status next to each result.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_search() {
  local version="${1:-}"
  banner; section "Search: Java ${version:-all}"
  ensure_brew 2>/dev/null || true

  if command -v brew &>/dev/null; then
    step "Searching Homebrew..."; echo ""
    brew_search_java "$version"
    if [[ ${#BREW_FORMULAE[@]} -gt 0 ]]; then
      echo -e "  ${CYAN}${BOLD}Formulae:${RESET}"
      for f in "${BREW_FORMULAE[@]}"; do
        brew list --formula "$f" &>/dev/null 2>&1 && \
          echo -e "  ${GREEN}  ${f}${RESET}  ${GREEN}● installed${RESET}" || \
          echo -e "  ${CYAN}  ${f}${RESET}"
      done; echo ""
    fi
    if [[ ${#BREW_CASKS[@]} -gt 0 ]]; then
      echo -e "  ${CYAN}${BOLD}Casks:${RESET}"
      for c in "${BREW_CASKS[@]}"; do
        brew list --cask "$c" &>/dev/null 2>&1 && \
          echo -e "  ${GREEN}  ${c}${RESET}  ${GREEN}● installed${RESET}" || \
          echo -e "  ${CYAN}  ${c}${RESET}"
      done; echo ""
    fi
    [[ ${#BREW_FORMULAE[@]} -eq 0 && ${#BREW_CASKS[@]} -eq 0 ]] && warn "No Homebrew results found."
  fi

  if [[ "$OS" == "linux" && "$PKG_MANAGER" != "brew" ]]; then
    step "Searching ${PKG_MANAGER}..."; echo ""
    linux_search_java "$version"
    if [[ ${#LINUX_PKGS[@]} -gt 0 ]]; then
      for p in "${LINUX_PKGS[@]}"; do echo -e "  ${CYAN}  ${p}${RESET}"; done
    else
      warn "No ${PKG_MANAGER} results found."
    fi
    echo ""
  fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm use <version|alias>
# The main command. Switches the active Java version:
#   1. Resolves named aliases (e.g. "work" → "17")
#   2. Scans locally installed JVMs for matches
#   3. If exactly one match → auto-selects (no menu)
#   4. If zero matches → searches Homebrew / pkg manager and offers to install
#   5. If multiple matches → shows an interactive numbered menu
#   6. After selection: optionally removes all other versions, writes JAVA_HOME
# ═══════════════════════════════════════════════════════════════════════════════
cmd_use() {
  local input="${1:-}"; local quiet="${2:-}"
  if [[ -z "$input" ]]; then
    err "Usage: jvm use <version|alias>"; echo ""; return 1
  fi

  local resolved; resolved=$(resolve_alias "$input")
  if [[ -n "$resolved" ]]; then info "Alias '${input}' → Java ${resolved}"; input="$resolved"; fi

  [[ "$quiet" != "--quiet" ]] && banner
  section "Switch to Java ${input}"

  scan_jvms
  ensure_brew 2>/dev/null || true

  # Build the interactive selection menu — parallel arrays for paths, labels, types
  declare -a MENU_PATHS=()
  declare -a MENU_LABELS=()
  declare -a MENU_TYPES=()      # "local" | "brew_formula" | "brew_cask" | "linux_pkg"
  declare -a MENU_INSTALLED=()  # "true" | "false"

  # First pass: collect locally installed JVMs matching the requested version
  for i in "${!ALL_JVM_PATHS[@]}"; do
    local major; major=$(echo "${ALL_JVM_VERSIONS[$i]}" | cut -d'.' -f1)
    if [[ "$major" == "$input" || "${ALL_JVM_VERSIONS[$i]}" == "$input" ]]; then
      MENU_PATHS+=("${ALL_JVM_PATHS[$i]}")
      MENU_LABELS+=("Java ${ALL_JVM_VERSIONS[$i]} (${ALL_JVM_VENDORS[$i]})  ·  ${ALL_JVM_PATHS[$i]}")
      MENU_TYPES+=("local"); MENU_INSTALLED+=("true")
    fi
  done

  # Auto-select if exactly one local match — no menu needed
  if [[ ${#MENU_PATHS[@]} -eq 1 ]]; then
    local java_home="${MENU_PATHS[0]}"
    ok "Switching to ${MENU_LABELS[0]}"
    echo ""
    write_java_home "$java_home"; log_switch "$input" "$java_home"
    echo ""; div
    ok "Active:    ${CYAN}$("${java_home}/bin/java" -version 2>&1 | head -1)${RESET}"
    ok "JAVA_HOME: ${CYAN}${java_home}${RESET}"
    echo ""
    return 0
  fi

  # Only search Homebrew/pkg-manager if no local match found
  if [[ ${#MENU_PATHS[@]} -eq 0 ]] && command -v brew &>/dev/null; then
    brew_search_java "$input"
    local _bf _bc _inst
    local _bfi=0; local _bflen=${#BREW_FORMULAE[@]}
    while [[ $_bfi -lt $_bflen ]]; do
      _bf="${BREW_FORMULAE[$_bfi]}"; _bfi=$((_bfi+1))
      [[ -z "$_bf" ]] && continue
      _inst="false"
      brew list --formula "$_bf" &>/dev/null 2>&1 && _inst="true"
      MENU_PATHS+=(""); MENU_TYPES+=("brew_formula"); MENU_INSTALLED+=("$_inst")
      [[ "$_inst" == "true" ]] && \
        MENU_LABELS+=("${_bf}  (brew formula)  ● installed") || \
        MENU_LABELS+=("${_bf}  (brew formula)  ↓ will install")
    done
    local _bci=0; local _bclen=${#BREW_CASKS[@]}
    while [[ $_bci -lt $_bclen ]]; do
      _bc="${BREW_CASKS[$_bci]}"; _bci=$((_bci+1))
      [[ -z "$_bc" ]] && continue
      _inst="false"
      brew list --cask "$_bc" &>/dev/null 2>&1 && _inst="true"
      MENU_PATHS+=(""); MENU_TYPES+=("brew_cask"); MENU_INSTALLED+=("$_inst")
      [[ "$_inst" == "true" ]] && \
        MENU_LABELS+=("${_bc}  (brew cask)  ● installed") || \
        MENU_LABELS+=("${_bc}  (brew cask)  ↓ will install")
    done
  fi

  if [[ "$OS" == "linux" && "$PKG_MANAGER" != "brew" ]]; then
    linux_search_java "$input"
    for p in "${LINUX_PKGS[@]:-}"; do
      [[ -z "$p" ]] && continue
      MENU_PATHS+=(""); MENU_TYPES+=("linux_pkg"); MENU_INSTALLED+=("false")
      MENU_LABELS+=("${p}  (${PKG_MANAGER})  ↓ will install")
    done
  fi
  # end: only search if no local match (brew/linux blocks above were conditional)

  if [[ ${#MENU_LABELS[@]} -eq 0 ]]; then
    err "No Java ${input} found locally or in package managers."
    info "Try: ${BOLD}jvm search ${input}${RESET}"; echo ""; return 1
  fi

  local prev_type=""
  for i in "${!MENU_LABELS[@]}"; do
    local t="${MENU_TYPES[$i]}"
    if [[ "$t" == "local" && "$prev_type" != "local" ]]; then
      echo -e "  ${GREEN}${BOLD}── Locally installed (instant, no download) ──${RESET}"
    elif [[ "$t" != "local" && "$prev_type" == "local" ]]; then
      echo ""; echo -e "  ${CYAN}${BOLD}── Available via package manager ──${RESET}"
    elif [[ "$t" != "local" && -z "$prev_type" ]]; then
      echo -e "  ${CYAN}${BOLD}── Available via package manager ──${RESET}"
    fi
    prev_type="$t"
    if [[ "$t" == "local" ]]; then
      echo -e "  ${GREEN}[$((i+1))]${RESET} ${MENU_LABELS[$i]}  ${GREEN}⚡ ready${RESET}"
    else
      echo -e "  ${CYAN}[$((i+1))]${RESET} ${MENU_LABELS[$i]}"
    fi
  done

  echo ""; echo -e "  ${DIM}[q] Quit${RESET}"; echo ""

  local sel
  while true; do
    read -rp "$(echo -e "  ${BOLD}Choice [1-${#MENU_LABELS[@]}]:${RESET} ")" sel
    [[ "$sel" == "q" || "$sel" == "Q" ]] && { warn "Aborted."; echo ""; return 0; }
    [[ "$sel" =~ ^[0-9]+$ ]] && [[ "$sel" -ge 1 ]] && [[ "$sel" -le "${#MENU_LABELS[@]}" ]] && break
    err "Invalid — enter a number between 1 and ${#MENU_LABELS[@]}."
  done

  local idx=$((sel-1))
  local chosen_type="${MENU_TYPES[$idx]}"
  local chosen_path="${MENU_PATHS[$idx]:-}"
  local chosen_pkg; chosen_pkg=$(echo "${MENU_LABELS[$idx]}" | awk '{print $1}')
  local chosen_installed="${MENU_INSTALLED[$idx]}"
  local java_home=""

  echo ""; step "Selected: ${CYAN}${MENU_LABELS[$idx]}${RESET}"; echo ""

  # Handle the user's chosen menu item: install if needed, then resolve JAVA_HOME
  case "$chosen_type" in
    local)
      java_home="$chosen_path"
      ok "Using locally installed JVM — no download needed." ;;
    brew_formula)
      [[ "$chosen_installed" == "false" ]] && { step "Installing ${chosen_pkg}..."; brew install "$chosen_pkg"; } || ok "${chosen_pkg} already installed."
      java_home=$(resolve_brew_java_home "$chosen_pkg" "false" "$input") ;;
    brew_cask)
      [[ "$chosen_installed" == "false" ]] && { step "Installing ${chosen_pkg}..."; brew install --cask "$chosen_pkg"; } || ok "${chosen_pkg} already installed."
      java_home=$(resolve_brew_java_home "$chosen_pkg" "true" "$input") ;;
    linux_pkg)
      step "Installing ${chosen_pkg} via ${PKG_MANAGER}..."
      case "$PKG_MANAGER" in
        apt)    sudo apt-get install -y "$chosen_pkg" ;;
        dnf)    sudo dnf install -y "$chosen_pkg" ;;
        yum)    sudo yum install -y "$chosen_pkg" ;;
        pacman) sudo pacman -S --noconfirm "$chosen_pkg" ;;
        zypper) sudo zypper install -y "$chosen_pkg" ;;
      esac
      scan_jvms
      for i in "${!ALL_JVM_VERSIONS[@]}"; do
        [[ "$(echo "${ALL_JVM_VERSIONS[$i]}" | cut -d'.' -f1)" == "$input" ]] && java_home="${ALL_JVM_PATHS[$i]}" && break
      done ;;
  esac

  # Fallback: try macOS java_home utility if JAVA_HOME still unknown
  if [[ -z "$java_home" || ! -d "$java_home" ]]; then
    [[ "$OS" == "macos" ]] && java_home=$(/usr/libexec/java_home -v "${input}" 2>/dev/null || true)
  fi

  # Final check: give up if no valid JAVA_HOME found
  if [[ -z "$java_home" || ! -d "$java_home" ]]; then
    err "Could not locate JAVA_HOME for Java ${input}."; return 1
  fi

  # Optionally clean up other Java versions after switching
  echo ""
  read -rp "$(echo -e "  ${YELLOW}Remove all other Java versions? [y/N]:${RESET} ")" rm_others
  [[ "$rm_others" =~ ^[Yy]$ ]] && _remove_all_except "$java_home" "$chosen_pkg" "$input"

  echo ""; write_java_home "$java_home"; log_switch "$input" "$java_home"
  echo ""; div
  ok "Active:    ${CYAN}$("${java_home}/bin/java" -version 2>&1 | head -1)${RESET}"
  ok "JAVA_HOME: ${CYAN}${java_home}${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm install <version>
# Installs a Java version via Homebrew or native pkg manager WITHOUT switching
# the active version. Presents a menu of available packages to choose from.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_install() {
  local version="${1:-}"
  [[ -z "$version" ]] && { err "Usage: jvm install <version>"; echo ""; return 1; }
  banner; section "Install Java ${version} (without switching)"
  ensure_brew 2>/dev/null || true
  brew_search_java "$version"

  declare -a PKG_LIST=(); declare -a PKG_TYPES=()
  for f in "${BREW_FORMULAE[@]:-}"; do [[ -n "$f" ]] && PKG_LIST+=("$f") && PKG_TYPES+=("formula"); done
  for c in "${BREW_CASKS[@]:-}"; do  [[ -n "$c" ]] && PKG_LIST+=("$c") && PKG_TYPES+=("cask"); done
  if [[ "$OS" == "linux" && "$PKG_MANAGER" != "brew" ]]; then
    linux_search_java "$version"
    for p in "${LINUX_PKGS[@]:-}"; do [[ -n "$p" ]] && PKG_LIST+=("$p") && PKG_TYPES+=("linux"); done
  fi

  [[ ${#PKG_LIST[@]} -eq 0 ]] && { err "No packages found for Java ${version}."; echo ""; return 1; }

  for i in "${!PKG_LIST[@]}"; do
    echo -e "  ${CYAN}[$((i+1))]${RESET} ${PKG_LIST[$i]}  ${DIM}(${PKG_TYPES[$i]})${RESET}"
  done; echo ""

  local sel
  while true; do
    read -rp "$(echo -e "  ${BOLD}Choice [1-${#PKG_LIST[@]}]:${RESET} ")" sel
    [[ "$sel" == "q" ]] && { warn "Aborted."; return 0; }
    [[ "$sel" =~ ^[0-9]+$ ]] && [[ "$sel" -ge 1 ]] && [[ "$sel" -le "${#PKG_LIST[@]}" ]] && break
    err "Invalid choice."
  done

  local idx=$((sel-1)); local pkg="${PKG_LIST[$idx]}"; local ptype="${PKG_TYPES[$idx]}"
  step "Installing ${pkg}..."
  case "$ptype" in
    formula) brew install "$pkg" ;;
    cask)    brew install --cask "$pkg" ;;
    linux)
      case "$PKG_MANAGER" in
        apt)    sudo apt-get install -y "$pkg" ;;
        dnf)    sudo dnf install -y "$pkg" ;;
        yum)    sudo yum install -y "$pkg" ;;
        pacman) sudo pacman -S --noconfirm "$pkg" ;;
        zypper) sudo zypper install -y "$pkg" ;;
      esac ;;
  esac
  ok "Installed ${pkg}. Active version unchanged."
  log_switch "installed:${version}" "${pkg}"
  info "To switch: ${BOLD}jvm use ${version}${RESET}"; echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm remove <version>
# Uninstalls a specific Java version. Refuses if the version is pinned.
# Tries Homebrew uninstall first, then filesystem deletion as fallback.
# Verifies cask versions before removing to avoid accidentally deleting wrong versions.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_remove() {
  local version="${1:-}"
  [[ -z "$version" ]] && { err "Usage: jvm remove <version>"; echo ""; return 1; }
  banner; section "Remove Java ${version}"

  if is_pinned "$version"; then
    err "Java ${version} is pinned. Run ${BOLD}jvm unpin ${version}${RESET}${RED} first."; echo ""; return 1
  fi

  scan_jvms
  local found=false
  for i in "${!ALL_JVM_PATHS[@]}"; do
    [[ "$(echo "${ALL_JVM_VERSIONS[$i]}" | cut -d'.' -f1)" == "$version" || "${ALL_JVM_VERSIONS[$i]}" == "$version" ]] && \
      { found=true; warn "Will remove: ${ALL_JVM_PATHS[$i]}"; }
  done

  [[ "$found" == "false" ]] && { warn "Java ${version} not found."; echo ""; return; }

  read -rp "$(echo -e "  ${RED}${BOLD}Confirm removal of Java ${version}? [y/N]:${RESET} ")" confirm
  [[ ! "$confirm" =~ ^[Yy]$ ]] && { warn "Aborted."; echo ""; return; }

  local _removed=false

  # ── 1. Homebrew uninstall — avoid subshell by using array, not pipe ──────────
  if command -v brew &>/dev/null; then
    local _fp="openjdk@${version}|java@${version}|temurin@${version}|zulu@${version}|corretto@${version}|semeru@${version}|liberica@${version}"
    local _cp="temurin@${version}|temurin|zulu@${version}|zulu|corretto@${version}|corretto|liberica@${version}|microsoft-openjdk@${version}|microsoft-openjdk"

    # Read into array first (avoids subshell variable loss from | while)
    local _brew_formulae=()
    while IFS= read -r _f; do [[ -n "$_f" ]] && _brew_formulae+=("$_f"); done \
      < <(brew list --formula 2>/dev/null | grep -E "$_fp" || true)

    local _brew_casks=()
    while IFS= read -r _c; do [[ -n "$_c" ]] && _brew_casks+=("$_c"); done \
      < <(brew list --cask 2>/dev/null | grep -E "$_cp" || true)

    for _f in "${_brew_formulae[@]:-}"; do
      step "Uninstalling brew formula: ${_f}"
      brew uninstall --force "$_f" 2>/dev/null && _removed=true || true
    done

    for _c in "${_brew_casks[@]:-}"; do
      # Verify this cask actually has a Java matching the requested version before removing
      # (e.g. 'temurin' might be Java 21, not Java 8)
      local _cask_home
      _cask_home=$(resolve_brew_java_home "$_c" "true" "$version" 2>/dev/null || true)
      if [[ -n "$_cask_home" ]]; then
        local _cv
        if command -v gtimeout &>/dev/null; then
          _cv=$(gtimeout 3s "${_cask_home}/bin/java" -version 2>&1 | head -1 | grep -oE '"[0-9]+' | tr -d '"' | head -1 || true)
        else
          _cv=$("${_cask_home}/bin/java" -version 2>&1 | head -1 | grep -oE '"[0-9]+' | tr -d '"' | head -1 || true)
        fi
        [[ "$_cv" == "1" ]] && _cv="8"
        [[ "$_cv" != "$version" ]] && continue  # wrong version, skip
      fi
      step "Uninstalling brew cask: ${_c}"
      brew uninstall --cask --force "$_c" 2>/dev/null && _removed=true || true
    done
  fi

  # ── 2. Filesystem removal — all install locations ────────────────────────────
  local _bases=(
    "/Library/Java/JavaVirtualMachines"
    "${HOME}/Library/Java/JavaVirtualMachines"
    "/usr/lib/jvm" "/usr/java" "/opt/java" "/opt/jdk"
  )
  local _base
  for _base in "${_bases[@]}"; do
    [[ -d "$_base" ]] || continue
    for _jdir in "${_base}"/*/; do
      [[ -d "$_jdir" ]] || continue
      local _jh="${_jdir}Contents/Home"
      [[ -d "$_jh" ]] || _jh="${_jdir%/}"
      [[ -x "${_jh}/bin/java" ]] || continue
      local _jver
      if command -v gtimeout &>/dev/null; then
        _jver=$(gtimeout 3s "${_jh}/bin/java" -version 2>&1 | head -1 | grep -oE '"[0-9]+' | tr -d '"' | head -1 || true)
      elif command -v timeout &>/dev/null; then
        _jver=$(timeout 3s "${_jh}/bin/java" -version 2>&1 | head -1 | grep -oE '"[0-9]+' | tr -d '"' | head -1 || true)
      else
        _jver=$("${_jh}/bin/java" -version 2>&1 | head -1 | grep -oE '"[0-9]+' | tr -d '"' | head -1 || true)
      fi
      [[ "$_jver" == "1" ]] && _jver="8"
      if [[ "$_jver" == "$version" ]]; then
        step "Removing ${_jdir}"
        if [[ "$_jdir" == /Library/* ]]; then
          sudo rm -rf "$_jdir" 2>/dev/null && _removed=true || warn "Could not remove (needs sudo): ${_jdir}"
        else
          rm -rf "$_jdir" 2>/dev/null && _removed=true || warn "Could not remove: ${_jdir}"
        fi
      fi
    done
  done

  if [[ "$_removed" == "true" ]]; then
    ok "Java ${version} removed."
  else
    warn "Could not remove Java ${version} automatically."
    info "Delete it manually:"
    for i in "${!ALL_JVM_PATHS[@]}"; do
      [[ "$(echo "${ALL_JVM_VERSIONS[$i]}" | cut -d'.' -f1)" == "$version" ]] && \
        info "  sudo rm -rf $(dirname "$(dirname "${ALL_JVM_PATHS[$i]}")")"
    done
  fi
  echo ""
}


# Helper: removes all Java installations except the one at $keep_home.
# Uninstalls matching Homebrew formulae/casks, then deletes JVM directories.
# Respects pinned versions — those are always preserved.
_remove_all_except() {
  local keep_home="$1"; local keep_pkg="${2:-}"; local keep_ver="${3:-}"
  if command -v brew &>/dev/null; then
    brew list --formula 2>/dev/null | grep -E "(java|jdk|temurin|zulu|corretto|liberica|semeru|graalvm)" | \
      while IFS= read -r f; do
        [[ -z "$f" || "$f" == "$keep_pkg" ]] && continue
        step "Removing brew formula: ${f}"; brew uninstall --force "$f" 2>/dev/null || true
      done
    brew list --cask 2>/dev/null | grep -E "(java|jdk|temurin|zulu|corretto|liberica|semeru|graalvm)" | \
      while IFS= read -r c; do
        [[ -z "$c" || "$c" == "$keep_pkg" ]] && continue
        step "Removing brew cask: ${c}"; brew uninstall --cask --force "$c" 2>/dev/null || true
      done
  fi
  for base in "/Library/Java/JavaVirtualMachines" "/usr/lib/jvm"; do
    [[ -d "$base" ]] || continue
    for jvm in "${base}"/*/; do
      [[ -d "$jvm" ]] || continue
      local jh="${jvm}Contents/Home"; [[ -d "$jh" ]] || jh="${jvm%/}"
      [[ "$jh" == "$keep_home" ]] && { ok "Keeping: ${jvm}"; continue; }
      [[ -x "${jh}/bin/java" ]] || continue
      local jver; jver=$("${jh}/bin/java" -version 2>&1 | head -1 | grep -oE '"[0-9]+' | tr -d '"' | head -1 || true)
      is_pinned "$jver" && { ok "Keeping pinned Java ${jver}"; continue; }
      step "Removing ${jvm}"; sudo rm -rf "$jvm" 2>/dev/null || warn "Could not remove ${jvm} (needs sudo)"
    done
  done
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm clean
# Removes ALL Java installations except the currently active one ($JAVA_HOME).
# Pinned versions are always preserved. Requires user confirmation.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_clean() {
  banner; section "Clean — Remove All Except Active"
  local active_home="${JAVA_HOME:-}"
  if [[ -z "$active_home" || ! -d "$active_home" ]]; then
    err "JAVA_HOME not set or invalid. Run ${BOLD}jvm use <version>${RESET} first."; echo ""; return 1
  fi
  ok "Keeping: ${CYAN}${active_home}${RESET}"; echo ""
  warn "All other Java installations will be removed (pinned versions are safe)."
  read -rp "$(echo -e "  ${RED}${BOLD}Confirm? [y/N]:${RESET} ")" confirm
  [[ ! "$confirm" =~ ^[Yy]$ ]] && { warn "Aborted."; echo ""; return; }
  _remove_all_except "$active_home" "" ""
  ok "Done. Only active Java remains."; echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm doctor
# Comprehensive health check for the Java environment:
#   - Verifies JAVA_HOME is set and points to a valid directory
#   - Checks that java binary in PATH matches JAVA_HOME
#   - Detects duplicate JAVA_HOME exports in the shell profile
#   - Finds and optionally removes broken symlinks in JVM directories
#   - Warns about conflicting tools (SDKMAN, jabba)
# ═══════════════════════════════════════════════════════════════════════════════
cmd_doctor() {
  banner; section "Doctor — Java Environment Health Check"
  local issues=0

  if [[ -z "${JAVA_HOME:-}" ]]; then
    err "JAVA_HOME is not set."; issues=$((issues+1))
  else
    ok "JAVA_HOME is set: ${CYAN}${JAVA_HOME}${RESET}"
    if [[ ! -d "$JAVA_HOME" ]]; then
      err "JAVA_HOME points to non-existent directory."; issues=$((issues+1))
    else
      ok "JAVA_HOME directory exists."
      if [[ ! -x "${JAVA_HOME}/bin/java" ]]; then
        err "${JAVA_HOME}/bin/java not found or not executable."; issues=$((issues+1))
      else
        ok "${JAVA_HOME}/bin/java is executable."
      fi
    fi
  fi

  if ! command -v java &>/dev/null; then
    err "java not found in PATH."; issues=$((issues+1))
  else
    local java_bin; java_bin=$(command -v java)
    ok "java in PATH: ${CYAN}${java_bin}${RESET}"
    if [[ -n "${JAVA_HOME:-}" && "$java_bin" != "${JAVA_HOME}/bin/java"* ]]; then
      warn "PATH java (${java_bin}) doesn't match JAVA_HOME — possible conflict."; issues=$((issues+1))
    else
      ok "PATH java matches JAVA_HOME."
    fi
    ok "java -version: ${CYAN}$(java -version 2>&1 | head -1)${RESET}"
  fi

  local profile; profile=$(get_shell_profile)
  if [[ -f "$profile" ]]; then
    local cnt; cnt=$(grep -c "export JAVA_HOME" "$profile" 2>/dev/null || true); cnt=${cnt:-0}
    if [[ "$cnt" -gt 1 ]]; then
      warn "${cnt} JAVA_HOME exports in ${profile} — may conflict."; issues=$((issues+1))
    elif [[ "$cnt" -eq 1 ]]; then
      ok "One clean JAVA_HOME entry in ${profile}."
    else
      warn "No JAVA_HOME in ${profile}. Run ${BOLD}jvm use <version>${RESET}."
    fi
  fi

  local _brew_opt; _brew_opt=$(brew --prefix 2>/dev/null)/opt
  for _base in "/Library/Java/JavaVirtualMachines" "/usr/lib/jvm" "$_brew_opt"; do
    [[ -d "$_base" ]] || continue
    for _link in "${_base}"/*; do
      if [[ -L "$_link" && ! -e "$_link" ]]; then
        warn "Broken symlink: ${_link}"
        read -rp "$(echo -e "    ${YELLOW}Auto-remove this broken symlink? [y/N]:${RESET} ")" _fix_sym
        if [[ "$_fix_sym" =~ ^[Yy]$ ]]; then
          sudo rm -f "$_link" 2>/dev/null && ok "Removed broken symlink: ${_link}" || err "Could not remove (needs sudo): ${_link}"
        else
          issues=$((issues+1))
        fi
      fi
    done
  done

  [[ -f "${HOME}/.sdkman/bin/sdkman-init.sh" ]] && \
    warn "SDKMAN detected — may override JAVA_HOME. Check your profile load order."
  [[ -f "${HOME}/.jabba/jabba.sh" ]] && \
    warn "jabba detected — may conflict with JAVA_HOME."

  echo ""; div
  if [[ $issues -eq 0 ]]; then
    ok "${GREEN}${BOLD}All checks passed! Your Java environment is healthy. ✓${RESET}"
  else
    err "${issues} issue(s) found. Review the warnings above."
  fi
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm env [version]
# Prints shell export statements (JAVA_HOME + PATH) to stdout.
# Useful in CI/CD pipelines: eval $(jvm env 17)
# Without a version argument, prints exports for the current JAVA_HOME.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_env() {
  local version="${1:-}"
  local java_home=""

  if [[ -n "$version" ]]; then
    scan_jvms
    local _i
    for _i in "${!ALL_JVM_PATHS[@]}"; do
      local _maj; _maj=$(echo "${ALL_JVM_VERSIONS[$_i]}" | cut -d'.' -f1)
      if [[ "$_maj" == "$version" ]]; then java_home="${ALL_JVM_PATHS[$_i]}"; break; fi
    done
    if [[ -z "$java_home" && "$OS" == "macos" ]]; then
      java_home=$(/usr/libexec/java_home -v "$version" 2>/dev/null || true)
    fi
    if [[ -z "$java_home" ]] && command -v brew &>/dev/null; then
      for _pkg in "openjdk@${version}" "temurin@${version}" "zulu@${version}" "corretto@${version}"; do
        brew list --formula "$_pkg" &>/dev/null 2>&1 || continue
        java_home=$(resolve_brew_java_home "$_pkg" "false" "$version")
        [[ -n "$java_home" ]] && break
      done
    fi
    if [[ -z "$java_home" ]]; then
      err "Java ${version} not found locally. Install it first: jvm install ${version}"
      return 1
    fi
  else
    java_home="${JAVA_HOME:-}"
    [[ -z "$java_home" ]] && { err "JAVA_HOME not set. Run: jvm use <version>"; return 1; }
  fi

  echo "export JAVA_HOME=\"${java_home}\""
  echo 'export PATH="$JAVA_HOME/bin:$PATH"'
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm history
# Shows the last 30 version-switch and install events (most recent first).
# ═══════════════════════════════════════════════════════════════════════════════
cmd_history() {
  banner; section "Switch History"
  if [[ ! -s "$JVM_HISTORY_FILE" ]]; then
    info "No history yet. Use ${BOLD}jvm use <version>${RESET} to start."; echo ""; return
  fi
  local _reversed; _reversed=$(tail -30 "$JVM_HISTORY_FILE" | awk '{lines[NR]=$0} END {for(i=NR;i>=1;i--) print lines[i]}')
  local count=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ "$line" == *"installed:"* ]]; then
      echo -e "  ${BLUE}⬇${RESET}  ${DIM}${line}${RESET}"
    else
      echo -e "  ${GREEN}⇄${RESET}  ${DIM}${line}${RESET}"
    fi
    count=$((count+1))
  done <<< "$_reversed"
  echo ""; ok "Last ${count} entries — full log: ${JVM_HISTORY_FILE}"; echo ""
}

# COMMAND: jvm alias <name> <version>  —  Create a named shortcut for a version
cmd_alias()   { local name="${1:-}"; local version="${2:-}"
                if [[ -z "$name" || -z "$version" ]]; then
                  err "Usage: jvm alias <name> <version>"
                  echo -e "  ${DIM}Example: jvm alias work 17${RESET}"; echo ""; return 1
                fi
                banner; set_alias "$name" "$version"; echo ""; }

# COMMAND: jvm aliases  —  List all defined aliases
cmd_aliases() { banner; section "Aliases"; list_aliases; echo ""; }

# COMMAND: jvm pin/unpin/pins  —  Manage pinned (protected) versions
cmd_pin()     { banner; [[ -z "${1:-}" ]] && { err "Usage: jvm pin <version>"; return 1; }; add_pin "$1"; echo ""; }
cmd_unpin()   { banner; [[ -z "${1:-}" ]] && { err "Usage: jvm unpin <version>"; return 1; }; remove_pin "$1"; echo ""; }
cmd_pins()    { banner; section "Pinned Versions"; list_pins; echo ""; }

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm project [version]
# Without args: reads .java-version from CWD and offers to switch to it.
# With a version: writes .java-version file in CWD. Also prints shell snippet
# for auto-switching on `cd` (hook into cd to call jvm_auto).
# ═══════════════════════════════════════════════════════════════════════════════
cmd_project() {
  local version="${1:-}"
  banner
  if [[ -n "$version" ]]; then
    echo "$version" > ".java-version"
    ok "Wrote .java-version (${version}) to ${PWD}"; echo ""
    info "To auto-switch on cd, add this to your shell profile:"
    echo ""
    echo -e "  ${DIM}jvm_auto() { [[ -f .java-version ]] && jvm use \$(cat .java-version) --quiet 2>/dev/null || true; }${RESET}"
    echo -e "  ${DIM}cd() { builtin cd \"\$@\" && jvm_auto; }${RESET}"
  else
    section "Project Java Version"
    if [[ -f ".java-version" ]]; then
      local pv; pv=$(cat .java-version)
      ok "This directory uses Java ${CYAN}${pv}${RESET}"; echo ""
      read -rp "$(echo -e "  ${BOLD}Switch to it now? [Y/n]:${RESET} ")" sw
      [[ ! "$sw" =~ ^[Nn]$ ]] && cmd_use "$pv"
    else
      warn "No .java-version file in ${PWD}."
      info "Create one: ${BOLD}jvm project <version>${RESET}"
    fi
  fi
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: jvm update
# Self-updates the jvm script by downloading the latest version from GitHub.
# Uses $JVM_UPDATE_URL (defaults to the repo’s raw main branch).
# ═══════════════════════════════════════════════════════════════════════════════
cmd_update() {
  banner; section "Self-Update jvm"
  local script_path; script_path=$(realpath "$0")
  info "Checking for updates..."
  if ! command -v curl &>/dev/null; then err "curl is required for updates."; return 1; fi
  local update_url="${JVM_UPDATE_URL:-https://raw.githubusercontent.com/utkarsh-ojha/utility/blob/main/mac/jvm}"
  local tmp; tmp=$(mktemp)
  if curl -fsSL "$update_url" -o "$tmp" 2>/dev/null; then
    chmod +x "$tmp"
    sudo mv "$tmp" "$script_path"
    ok "jvm updated at ${script_path}"
  else
    rm -f "$tmp"
    warn "Could not fetch update from ${update_url}."
    info "Set JVM_UPDATE_URL env var to point to your own hosted script."
  fi
  echo ""
}

# ─── Initialise platform and dispatch ───────────────────────────────────────────
detect_platform

# First CLI argument is the sub-command; default to "help" if none given
CMD="${1:-help}"
shift || true

# Route to the appropriate cmd_* function

case "$CMD" in
  use)             cmd_use "$@" ;;
  list|ls)         cmd_list ;;
  current)         cmd_current ;;
  search)          cmd_search "$@" ;;
  install)         cmd_install "$@" ;;
  remove|rm)       cmd_remove "$@" ;;
  clean)           cmd_clean ;;
  pin)             cmd_pin "$@" ;;
  unpin)           cmd_unpin "$@" ;;
  pins)            cmd_pins ;;
  doctor)          cmd_doctor ;;
  env)             cmd_env "$@" ;;
  history)         cmd_history ;;
  alias)           cmd_alias "$@" ;;
  aliases)         cmd_aliases ;;
  project)         cmd_project "$@" ;;
  update)          cmd_update ;;
  help|-h|--help)  cmd_help "$@" ;;
  *)
    err "Unknown command: ${CMD}"
    echo -e "  ${DIM}Run ${BOLD}jvm help${RESET}${DIM} for all commands.${RESET}"
    echo ""; exit 1 ;;
esac
