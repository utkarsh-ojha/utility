# ─── Entry point ──────────────────────────────────────────────────────────────
CMD="${1:-help}"
shift || true

case "$CMD" in
  history|hist)       cmd_history "${1:-}" ;;
  copy|cp)            cmd_copy "${1:-}" ;;
  remove|rm)          cmd_remove "${1:-}" ;;
  clean)              cmd_clean ;;
  search|grep)        cmd_search "$*" ;;
  watcher)            cmd_watcher ;;
  start)              cmd_start ;;
  stop)               cmd_stop ;;
  status)             cmd_status ;;
  install|setup)      cmd_install ;;
  uninstall)           cmd_uninstall ;;
  help|-h|--help)     cmd_help ;;
  *)
    err "Unknown command: ${CMD}"
    echo -e "  ${DIM}Run ${BOLD}clip help${RESET}${DIM} for all commands.${RESET}"
    echo ""; exit 1 ;;
esac
