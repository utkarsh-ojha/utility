  echo -e "    ${CYAN}●${RESET}  Bookmarks are stored in ${BOLD}~/.goto_registry${RESET} as ${BOLD}alias|path${RESET}"
  echo -e "    ${CYAN}●${RESET}  A ${BOLD}shell function wrapper${RESET} is injected into your .zshrc/.bashrc"
  echo -e "    ${CYAN}●${RESET}  The function calls the script, captures the target path, and runs ${BOLD}cd${RESET}"
  echo -e "    ${CYAN}●${RESET}  Sub-pathing lets you ${BOLD}goto project/src/components${RESET}"
