}

# ─── Entry point ──────────────────────────────────────────────────────────────
detect_platform

CMD="${1:-help}"
shift || true

case "$CMD" in
  kill)               cmd_kill "${1:-}" ;;
  list|ls)            cmd_list ;;
  watch)              cmd_watch "${1:-}" ;;
  history)            cmd_history ;;
  help|-h|--help)     cmd_help ;;
  *)
    # Bare port number
    if [[ "$CMD" =~ ^[0-9]+$ ]]; then
      cmd_show "$CMD"
    else
      err "Unknown command: ${CMD}"
      echo -e "  ${DIM}Run ${BOLD}portman help${RESET}${DIM} for all commands.${RESET}"
      echo ""; exit 1
    fi ;;
esac
