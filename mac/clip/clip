#!/usr/bin/env bash
# =============================================================================
# clip — Clipboard History Manager
# Persistent clipboard history for macOS with search, recall, and auto-start.
#
# Usage:
#   clip history [n]      show clipboard history (last 50, or last n)
#   clip copy <n>         copy the n-th item back to clipboard
#   clip remove <n>       delete a specific entry
#   clip search <query>   search history for a string
#   clip clean            wipe all history
#   clip install          install clip + auto-start watcher on boot
#   clip uninstall        undo install (stop watcher, remove agent & symlink)
#   clip start            start the clipboard watcher
#   clip stop             stop the clipboard watcher
#   clip status           check if the watcher is running
#   clip help
# =============================================================================

set -eo pipefail

# ─── Colours ──────────────────────────────────────────────────────────────────
BOLD="\033[1m"; DIM="\033[2m"; RESET="\033[0m"
RED="\033[0;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"
CYAN="\033[0;36m"; BLUE="\033[0;34m"; MAGENTA="\033[0;35m"
WHITE="\033[1;37m"; GREY="\033[0;90m"

# ─── Constants ────────────────────────────────────────────────────────────────
CLIP_VERSION="1.0"
HISTORY_FILE="${HOME}/.clip_history"
MAX_ENTRIES=100
DEFAULT_SHOW=50
POLL_INTERVAL=1
PLIST_LABEL="com.user.clipbuddy"
PLIST_PATH="${HOME}/Library/LaunchAgents/${PLIST_LABEL}.plist"
PID_FILE="${HOME}/.clip_watcher.pid"

touch "$HISTORY_FILE"

# ─── Output helpers ───────────────────────────────────────────────────────────
div()     { echo -e "${DIM}  ────────────────────────────────────────────────────${RESET}"; }
section() { echo ""; echo -e "  ${CYAN}${BOLD}$1${RESET}"; div; }
ok()      { echo -e "  ${GREEN}✓${RESET} $*"; }
warn()    { echo -e "  ${YELLOW}⚠${RESET}  $*"; }
err()     { echo -e "  ${RED}✗${RESET} $*"; }
info()    { echo -e "  ${BLUE}→${RESET} $*"; }
step()    { echo -e "  ${MAGENTA}◆${RESET} $*"; }

banner() {
  echo ""
  echo -e "${CYAN}${BOLD}  📋  clip v${CLIP_VERSION}${RESET}  ${DIM}·  By ${BOLD}UTKARSH OJHA${RESET}${DIM}  ·  Clipboard History Manager${RESET}"
  echo -e "${DIM}  Copy it. Find it. Recall it.${RESET}"
  div; echo ""
}

# ─── Base64 helpers (macOS-compatible) ────────────────────────────────────────
b64_encode() { base64 | tr -d '\n'; }
b64_decode() { base64 -D 2>/dev/null || base64 -d 2>/dev/null; }

# ─── Validate index ──────────────────────────────────────────────────────────
validate_index() {
  local idx="$1"
  if ! [[ "$idx" =~ ^[0-9]+$ ]] || [[ "$idx" -lt 1 ]]; then
    err "Invalid index: '${idx}' — must be a positive number"; echo ""; return 1
  fi
  local total; total=$(wc -l < "$HISTORY_FILE" | tr -d ' ')
  if [[ "$idx" -gt "$total" ]]; then
    err "Index ${idx} out of range — only ${total} item(s) in history"; echo ""; return 1
  fi
  return 0
}

# ─── Get the line number for a given display index ────────────────────────────
# Index [1] = most recent = last line in file
index_to_line() {
  local idx="$1"
  local total; total=$(wc -l < "$HISTORY_FILE" | tr -d ' ')
  echo $(( total - idx + 1 ))
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip history [n]
# ═══════════════════════════════════════════════════════════════════════════════
cmd_history() {
  local count="${1:-$DEFAULT_SHOW}"
  if ! [[ "$count" =~ ^[0-9]+$ ]] || [[ "$count" -lt 1 ]]; then
    err "Invalid count: '${count}'"; echo ""; return 1
  fi

  banner; section "Clipboard History  ${DIM}(last ${count})${RESET}"

  local total; total=$(wc -l < "$HISTORY_FILE" | tr -d ' ')
  if [[ "$total" -eq 0 ]]; then
    info "History is empty. Start copying things!"
    echo ""; return 0
  fi

  [[ "$count" -gt "$total" ]] && count="$total"

  local idx=1
  local reversed; reversed=$(tail -n "$count" "$HISTORY_FILE" | awk '{lines[NR]=$0} END {for(i=NR;i>=1;i--) print lines[i]}')
  # Read from bottom (most recent) upward
  while IFS='|' read -r timestamp encoded; do
    [[ -z "$encoded" ]] && continue
    local decoded; decoded=$(echo "$encoded" | b64_decode)
    # Preview: first 50 chars, collapse newlines to spaces
    local preview; preview=$(echo "$decoded" | tr '\n' ' ' | sed 's/  */ /g' | cut -c1-50)
    [[ ${#decoded} -gt 50 ]] && preview="${preview}…"

    printf "  ${CYAN}${BOLD}[%3d]${RESET}  ${GREY}%s${RESET}  %s\n" "$idx" "$timestamp" "$preview"
    idx=$((idx + 1))
  done <<< "$reversed"

  echo ""
  ok "${total} total item(s) in history"
  info "Recall an item: ${BOLD}clip copy <n>${RESET}   Remove: ${BOLD}clip remove <n>${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip copy <n>
# ═══════════════════════════════════════════════════════════════════════════════
cmd_copy() {
  local idx="$1"
  [[ -z "$idx" ]] && { err "Usage: clip copy <n>"; echo ""; return 1; }
  validate_index "$idx" || return 1

  banner; section "Copy to Clipboard"

  local line_num; line_num=$(index_to_line "$idx")
  local encoded; encoded=$(sed -n "${line_num}p" "$HISTORY_FILE" | cut -d'|' -f2-)
  local decoded; decoded=$(echo "$encoded" | b64_decode)

  # Push to system clipboard
  echo -n "$decoded" | pbcopy

  # Preview
  local preview; preview=$(echo "$decoded" | tr '\n' ' ' | sed 's/  */ /g' | cut -c1-60)
  ok "Copied item [${idx}] to clipboard"
  echo -e "  ${DIM}${preview}${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip remove <n>
# ═══════════════════════════════════════════════════════════════════════════════
cmd_remove() {
  local idx="$1"
  [[ -z "$idx" ]] && { err "Usage: clip remove <n>"; echo ""; return 1; }
  validate_index "$idx" || return 1

  banner; section "Remove Entry"

  local line_num; line_num=$(index_to_line "$idx")

  # Show what will be removed
  local encoded; encoded=$(sed -n "${line_num}p" "$HISTORY_FILE" | cut -d'|' -f2-)
  local decoded; decoded=$(echo "$encoded" | b64_decode)
  local preview; preview=$(echo "$decoded" | tr '\n' ' ' | sed 's/  */ /g' | cut -c1-50)

  warn "Removing item [${idx}]: ${preview}"

  # macOS sed requires '' after -i
  sed -i '' "${line_num}d" "$HISTORY_FILE"

  ok "Item [${idx}] removed — history re-indexed"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip clean
# ═══════════════════════════════════════════════════════════════════════════════
cmd_clean() {
  banner; section "Clean History"

  local total; total=$(wc -l < "$HISTORY_FILE" | tr -d ' ')
  if [[ "$total" -eq 0 ]]; then
    info "History is already empty."
    echo ""; return 0
  fi

  warn "${total} item(s) will be permanently deleted."
  echo ""
  read -rp "$(echo -e "  ${RED}${BOLD}Wipe all clipboard history? [y/N]:${RESET} ")" confirm
  [[ ! "$confirm" =~ ^[Yy]$ ]] && { warn "Aborted."; echo ""; return 0; }

  : > "$HISTORY_FILE"
  echo ""
  ok "Clipboard history wiped clean"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip search <query>
# ═══════════════════════════════════════════════════════════════════════════════
cmd_search() {
  local query="$1"
  [[ -z "$query" ]] && { err "Usage: clip search <query>"; echo ""; return 1; }

  banner; section "Search: \"${query}\""

  local total; total=$(wc -l < "$HISTORY_FILE" | tr -d ' ')
  if [[ "$total" -eq 0 ]]; then
    info "History is empty."
    echo ""; return 0
  fi

  local found=0
  local idx=1

  local reversed; reversed=$(awk '{lines[NR]=$0} END {for(i=NR;i>=1;i--) print lines[i]}' "$HISTORY_FILE")
  # Read from bottom (most recent) upward
  while IFS='|' read -r timestamp encoded; do
    [[ -z "$encoded" ]] && { idx=$((idx + 1)); continue; }
    local decoded; decoded=$(echo "$encoded" | b64_decode)
    # Case-insensitive search
    if echo "$decoded" | grep -qi "$query" 2>/dev/null; then
      local preview; preview=$(echo "$decoded" | tr '\n' ' ' | sed 's/  */ /g' | cut -c1-50)
      [[ ${#decoded} -gt 50 ]] && preview="${preview}…"
      printf "  ${CYAN}${BOLD}[%3d]${RESET}  ${GREY}%s${RESET}  %s\n" "$idx" "$timestamp" "$preview"
      found=$((found + 1))
    fi
    idx=$((idx + 1))
  done <<< "$reversed"

  echo ""
  info "Use ${BOLD}clip copy <n>${RESET} to recall an item"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip watcher (internal — background clipboard polling)
# ═══════════════════════════════════════════════════════════════════════════════
cmd_watcher() {
  local last_hash=""

  while true; do
    local current; current=$(pbpaste 2>/dev/null || true)

    # Skip empty clipboard
    if [[ -n "$current" ]]; then
      # Hash to detect changes
      local current_hash; current_hash=$(echo -n "$current" | md5 2>/dev/null || echo -n "$current" | md5sum 2>/dev/null | awk '{print $1}')

      if [[ "$current_hash" != "$last_hash" ]]; then
        last_hash="$current_hash"

        # Check if this exact content is already the most recent entry
        local last_encoded; last_encoded=$(tail -1 "$HISTORY_FILE" 2>/dev/null | cut -d'|' -f2-)
        local last_decoded=""
        [[ -n "$last_encoded" ]] && last_decoded=$(echo "$last_encoded" | b64_decode 2>/dev/null || true)

        if [[ "$current" != "$last_decoded" ]]; then
          local timestamp; timestamp=$(date '+%Y-%m-%d %H:%M:%S')
          local encoded; encoded=$(echo -n "$current" | b64_encode)
          echo "${timestamp}|${encoded}" >> "$HISTORY_FILE"

          # Enforce max entries
          local total; total=$(wc -l < "$HISTORY_FILE" | tr -d ' ')
          if [[ "$total" -gt "$MAX_ENTRIES" ]]; then
            local excess=$((total - MAX_ENTRIES))
            sed -i '' "1,${excess}d" "$HISTORY_FILE"
          fi
        fi
      fi
    fi

    sleep "$POLL_INTERVAL"
  done
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip start
# ═══════════════════════════════════════════════════════════════════════════════
cmd_start() {
  banner; section "Start Watcher"

  # Check if already running
  if [[ -f "$PID_FILE" ]]; then
    local existing_pid; existing_pid=$(cat "$PID_FILE")
    if kill -0 "$existing_pid" 2>/dev/null; then
      ok "Watcher is already running (PID ${existing_pid})"
      echo ""; return 0
    else
      rm -f "$PID_FILE"
    fi
  fi

  # Resolve script path
  local script_path
  script_path=$(command -v clip 2>/dev/null || echo "$0")

  nohup "$script_path" watcher > /dev/null 2>&1 &
  local watcher_pid=$!
  echo "$watcher_pid" > "$PID_FILE"

  ok "Watcher started (PID ${watcher_pid})"
  info "Polling clipboard every ${POLL_INTERVAL}s — max ${MAX_ENTRIES} entries"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip stop
# ═══════════════════════════════════════════════════════════════════════════════
cmd_stop() {
  banner; section "Stop Watcher"

  if [[ ! -f "$PID_FILE" ]]; then
    info "No watcher PID file found."
    echo ""; return 0
  fi

  local watcher_pid; watcher_pid=$(cat "$PID_FILE")
  if kill -0 "$watcher_pid" 2>/dev/null; then
    kill "$watcher_pid" 2>/dev/null
    rm -f "$PID_FILE"
    ok "Watcher stopped (PID ${watcher_pid})"
  else
    rm -f "$PID_FILE"
    info "Watcher was not running (stale PID file cleaned up)"
  fi
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip status
# ═══════════════════════════════════════════════════════════════════════════════
cmd_status() {
  banner; section "Watcher Status"

  local total; total=$(wc -l < "$HISTORY_FILE" | tr -d ' ')

  if [[ -f "$PID_FILE" ]]; then
    local watcher_pid; watcher_pid=$(cat "$PID_FILE")
    if kill -0 "$watcher_pid" 2>/dev/null; then
      echo -e "  ${GREEN}●${RESET}  Watcher is ${GREEN}${BOLD}running${RESET}  ${DIM}(PID ${watcher_pid})${RESET}"
    else
      echo -e "  ${RED}●${RESET}  Watcher is ${RED}${BOLD}not running${RESET}  ${DIM}(stale PID)${RESET}"
      rm -f "$PID_FILE"
    fi
  else
    # Check via launchctl
    if launchctl list 2>/dev/null | grep -q "$PLIST_LABEL"; then
      echo -e "  ${GREEN}●${RESET}  Watcher is ${GREEN}${BOLD}running${RESET}  ${DIM}(via launchctl)${RESET}"
    else
      echo -e "  ${RED}●${RESET}  Watcher is ${RED}${BOLD}not running${RESET}"
    fi
  fi

  echo ""
  info "History: ${BOLD}${total}${RESET} item(s) stored"
  info "History file: ${DIM}${HISTORY_FILE}${RESET}"
  info "Max entries: ${BOLD}${MAX_ENTRIES}${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip install
# Install clip to PATH and configure LaunchAgent for auto-start.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_install() {
  banner; section "Install"

  # Resolve the real path of this script, following all symlinks
  local script_src="$0"
  while [[ -L "$script_src" ]]; do
    local link_target; link_target=$(readlink "$script_src")
    if [[ "$link_target" == /* ]]; then
      script_src="$link_target"
    else
      script_src="$(cd "$(dirname "$script_src")" && pwd)/${link_target}"
    fi
  done
  script_src="$(cd "$(dirname "$script_src")" && pwd)/$(basename "$script_src")"

  local install_path="/usr/local/bin/clip"

  # Step 1: Symlink to /usr/local/bin
  step "Installing clip to ${install_path}..."

  if [[ "$script_src" == "$install_path" ]]; then
    ok "clip is already installed at ${install_path} — skipping symlink"
  else
    if [[ -L "$install_path" || -f "$install_path" ]]; then
      warn "${install_path} already exists — replacing"
      if [[ -w "/usr/local/bin" ]]; then
        rm -f "$install_path"
      else
        sudo rm -f "$install_path"
      fi
    fi

    if [[ -w "/usr/local/bin" ]]; then
      ln -sf "$script_src" "$install_path"
    else
      info "Requires sudo to write to /usr/local/bin"
      sudo ln -sf "$script_src" "$install_path"
    fi
    ok "Symlinked ${install_path} → ${script_src}"
  fi

  # Step 2: Create LaunchAgent plist
  step "Creating LaunchAgent at ${PLIST_PATH}..."
  mkdir -p "${HOME}/Library/LaunchAgents"

  cat > "$PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${install_path}</string>
        <string>watcher</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/clip_watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/clip_watcher.err</string>
</dict>
</plist>
PLIST

  ok "LaunchAgent plist created"

  # Step 3: Load the agent
  step "Loading LaunchAgent..."
  launchctl unload "$PLIST_PATH" 2>/dev/null || true
  launchctl load -w "$PLIST_PATH" 2>/dev/null

  ok "LaunchAgent loaded — watcher will auto-start on boot"

  echo ""
  ok "Setup complete!"
  echo ""
  info "The clipboard watcher is now running in the background."
  info "It will start automatically on every system boot."
  echo ""
  echo -e "  ${DIM}To check status:${RESET}   ${BOLD}clip status${RESET}"
  echo -e "  ${DIM}To view history:${RESET}   ${BOLD}clip history${RESET}"
  echo -e "  ${DIM}To undo install:${RESET}   ${BOLD}clip uninstall${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# COMMAND: clip uninstall
# Undo clip setup — stop watcher, remove LaunchAgent, remove symlink.
# ═══════════════════════════════════════════════════════════════════════════════
cmd_uninstall() {
  banner; section "Uninstall"

  local install_path="/usr/local/bin/clip"

  # Step 1: Stop the watcher if running
  step "Stopping watcher..."
  if [[ -f "$PID_FILE" ]]; then
    local watcher_pid; watcher_pid=$(cat "$PID_FILE")
    kill "$watcher_pid" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
  ok "Watcher stopped"

  # Step 2: Unload and remove LaunchAgent
  step "Removing LaunchAgent..."
  if [[ -f "$PLIST_PATH" ]]; then
    launchctl unload "$PLIST_PATH" 2>/dev/null || true
    rm -f "$PLIST_PATH"
    ok "LaunchAgent unloaded and removed"
  else
    info "No LaunchAgent found — skipping"
  fi

  # Step 3: Remove symlink from /usr/local/bin
  step "Removing ${install_path}..."
  if [[ -L "$install_path" || -f "$install_path" ]]; then
    if [[ -w "/usr/local/bin" ]]; then
      rm -f "$install_path"
    else
      info "Requires sudo to remove ${install_path}"
      sudo rm -f "$install_path"
    fi
    ok "Removed ${install_path}"
  else
    info "${install_path} not found — skipping"
  fi

  echo ""
  ok "Uninstall complete!"
  echo ""
  info "The clipboard watcher has been stopped."
  info "LaunchAgent has been removed — watcher will no longer auto-start."
  info "History file at ${BOLD}${HISTORY_FILE}${RESET} was kept. Delete manually if needed."
  echo ""
}

