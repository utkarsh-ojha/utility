# ─── Entry point ──────────────────────────────────────────────────────────────
detect_platform

CMD="${1:-help}"
shift || true

case "$CMD" in
  add)                cmd_add "${1:-}" ;;
  list|ls)            cmd_list ;;
  remove|rm)          cmd_remove "${1:-}" ;;
  clean)              cmd_clean ;;
  install)            cmd_install ;;
  uninstall)          cmd_uninstall ;;
  help|-h|--help)     cmd_help ;;
  *)
    # Treat as a jump target (goto <name> or goto <name>/sub/path)
    cmd_jump "$CMD"
    ;;
esac
